# Copy to .env for local development or deployment.
PORT=3120
HOST=127.0.0.1

# The MCP API key. Clients authenticate with ?api_key=<this> (or Authorization: Bearer <this>).
# Generate with:  openssl rand -hex 32
GSC_MCP_API_KEY=

# Absolute path to the Google "authorized_user" token JSON (refresh token).
# Lives outside the repo.
GSC_TOKEN=/absolute/path/to/gsc-token.json
