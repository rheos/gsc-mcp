# Copy to .env on the box (git-ignored). Loaded by gsc-mcp.service via EnvironmentFile.
PORT=3120
HOST=127.0.0.1

# The MCP API key. Clients authenticate with ?api_key=<this> (or Authorization: Bearer <this>).
# Generate with:  openssl rand -hex 32
GSC_MCP_API_KEY=

# Absolute path to the Google "authorized_user" token JSON (refresh token).
# Lives OUT of the repo. Generate locally via the gsc auth flow, then scp it to the box.
GSC_TOKEN=/opt/gsc-mcp/.secrets/gsc-token.json
